rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Padrão seguro: nada é lido nem gravado pelo navegador.
    // Libere coleções específicas somente depois de ativar o Firebase Authentication
    // e escrever regras com "request.auth != null".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
